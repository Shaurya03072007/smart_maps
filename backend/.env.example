# ============================================================================
# SmartMaps Agentic Backend Configuration (.env)
# All keys live ONLY on the backend. The Android app has ZERO API keys.
# ============================================================================

# 1. Gemini AI Key for Google ADK (NOT Google Maps — get free at https://aistudio.google.com/apikey)
# Note: Even if left blank, the backend has a built-in Smart Concierge fallback!
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ADK_MODEL=gemini-2.5-flash

# 2. Maps: 100% Keyless by default (uses OpenFreeMap vector tiles + Photon/OSM search).
# Optional MapTiler key ONLY if you want custom MapTiler styles:
MAPTILER_API_KEY=

# 3. Optional Supabase Cloud Sync (Backend uses fast local SQLite automatically if blank)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Server Host & Port
PORT=8000
HOST=0.0.0.0
